{
    "compilerOptions": {
        "module": "ES2022",
        "target": "ES2022",
        "outDir": "dist",
        "paths": {
            "#*": [
                "./src/*"
            ]
        },
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "sourceMap": true,
        "removeComments": true,
        "types": [
            "@wxn0brp/flanker-ui"
        ]
    },
    "include": [
        "src"
    ],
    "tsc-alias": {
        "resolveFullPaths": true,
        "verbose": false
    }
}